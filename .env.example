# Copy to .env and fill in. Never commit .env.

# Gemini API key, free (aistudio.google.com > Get API key). Used by default.
GEMINI_API_KEY=

# Optional backup Gemini key from a different Google Cloud project; used when the primary is
# out of quota or unavailable. Keep the value private; set the matching GitHub Actions secret too.
GEMINI_FALLBACK_API_KEY=

# Optional: Claude API key, only if you set models.provider: claude in settings.yaml
ANTHROPIC_API_KEY=

# Apify token (console.apify.com > Settings > Integrations). Scraping runs on Apify's side,
# with no LinkedIn login or cookie from you, so your account is never touched.
APIFY_TOKEN=

# Telegram: create a bot with @BotFather, paste the token, message the bot once,
# then run `python -m engine telegram-setup` to get your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# live | mock
ENGINE_MODE=live
