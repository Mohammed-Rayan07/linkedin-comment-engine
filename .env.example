# Copy to .env and fill in. Never commit .env.

# Claude API key (console.anthropic.com > API keys)
ANTHROPIC_API_KEY=

# Apify token (console.apify.com > Settings > Integrations). Scraping runs on Apify's side,
# with no LinkedIn login or cookie from you, so your account is never touched.
APIFY_TOKEN=

# Telegram: create a bot with @BotFather, paste the token, message the bot once,
# then run `python -m engine telegram-setup` to get your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# live | mock
ENGINE_MODE=live
